# tail_rotor.obj
# Hélice del rotor de cola, modelo separado.
# Está centrada en el origen local y sus aspas están en el plano YZ.
# Para rotarla lateralmente se debe usar rotación alrededor del eje X.

# Aspa vertical
v 0.0 -0.45 -0.04
v 0.0  0.45 -0.04
v 0.0  0.45  0.04
v 0.0 -0.45  0.04

# Aspa horizontal
v 0.0 -0.04 -0.45
v 0.0  0.04 -0.45
v 0.0  0.04  0.45
v 0.0 -0.04  0.45

# Centro del rotor de cola
v -0.04 -0.08 -0.08
v  0.04 -0.08 -0.08
v  0.04  0.08 -0.08
v -0.04  0.08 -0.08
v -0.04 -0.08  0.08
v  0.04 -0.08  0.08
v  0.04  0.08  0.08
v -0.04  0.08  0.08

f 1 2 3
f 1 3 4
f 5 6 7
f 5 7 8

# Cubo central
f 9 10 11
f 9 11 12
f 13 16 15
f 13 15 14
f 9 13 14
f 9 14 10
f 12 11 15
f 12 15 16
f 9 12 16
f 9 16 13
f 10 14 15
f 10 15 11
